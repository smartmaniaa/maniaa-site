---
import Layout from '../layouts/Layout.astro';
import CTAWhatsApp from '../components/CTAWhatsApp.astro';
---

<Layout
  title="O Escritório — Manià Arquitetura | Sorocaba/SP"
  description="Conheça a Manià Arquitetura — escritório de arquitetura e urbanismo em Sorocaba/SP com 12 anos de mercado."
>
  <!-- Hero -->
  <section class="bg-stone-50 pt-16 pb-20 px-6 border-b border-stone-200">
    <div class="max-w-6xl mx-auto">
      <p class="text-stone-500 text-xs font-medium tracking-widest uppercase mb-4">O escritório</p>
      <h1 class="text-4xl sm:text-5xl font-semibold text-stone-900 tracking-tight mb-5 max-w-2xl">
        Manià Arquitetura
      </h1>
      <p class="text-lg text-stone-500 max-w-2xl leading-relaxed">
        Doze anos projetando em Sorocaba e região. Residências, comércios, reformas e obras de marcas reconhecidas — tudo com o mesmo método: escutar antes de desenhar.
      </p>
    </div>
  </section>

  <!-- Conteúdo em breve -->
  <section class="bg-white py-24 px-6">
    <div class="max-w-6xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 text-stone-400 text-sm mb-6">
        <div class="w-2 h-2 rounded-full bg-stone-300"></div>
        Página em construção
      </div>
      <h2 class="text-2xl font-semibold text-stone-700 mb-4">Em breve, mais sobre o escritório.</h2>
      <p class="text-stone-400 max-w-md mx-auto leading-relaxed">
        Estamos preparando o conteúdo desta página — história, equipe e metodologia. Enquanto isso, você pode entrar em contato pelo WhatsApp.
      </p>
    </div>
  </section>

  <CTAWhatsApp />
</Layout>

---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contato — Manià Arquitetura | Sorocaba/SP"
  description="Entre em contato com a Manià Arquitetura. WhatsApp, e-mail ou formulário. Sorocaba/SP."
>
  <section class="bg-stone-50 pt-16 pb-20 px-6 border-b border-stone-200">
    <div class="max-w-6xl mx-auto">
      <p class="text-stone-500 text-xs font-medium tracking-widest uppercase mb-4">Contato</p>
      <h1 class="text-4xl sm:text-5xl font-semibold text-stone-900 tracking-tight mb-5">
        Vamos conversar.
      </h1>
      <p class="text-lg text-stone-500 max-w-xl leading-relaxed">
        A conversa inicial é sem compromisso. Conta o que você tem em mente — e a gente diz se faz sentido e como podemos ajudar.
      </p>
    </div>
  </section>

  <section class="bg-white py-16 px-6">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-16">

      <!-- Canais diretos -->
      <div>
        <h2 class="text-xl font-semibold text-stone-900 mb-8">Canais diretos</h2>
        <ul class="flex flex-col gap-6">
          <li>
            <a
              href="https://wa.me/5515991252290?text=Ol%C3%A1%2C%20vim%20pelo%20site%20e%20gostaria%20de%20conversar%20sobre%20meu%20projeto"
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-start gap-4 p-5 bg-stone-900 rounded-xl hover:bg-stone-800 transition-colors"
            >
              <div class="w-10 h-10 bg-stone-700 rounded-lg flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-stone-100">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                </svg>
              </div>
              <div>
                <p class="text-stone-100 font-semibold">WhatsApp</p>
                <p class="text-stone-400 text-sm mt-0.5">(15) 9125-2290 · resposta rápida</p>
              </div>
            </a>
          </li>
          <li class="flex items-start gap-4 p-5 bg-stone-50 border border-stone-200 rounded-xl">
            <div class="w-10 h-10 bg-stone-100 border border-stone-200 rounded-lg flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-stone-600">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
              </svg>
            </div>
            <div>
              <p class="text-stone-900 font-semibold">E-mail</p>
              <a href="mailto:leonardo@maniaa.com.br" class="text-stone-500 text-sm mt-0.5 hover:text-stone-700 transition-colors block">
                leonardo@maniaa.com.br
              </a>
            </div>
          </li>
          <li class="flex items-start gap-4 p-5 bg-stone-50 border border-stone-200 rounded-xl">
            <div class="w-10 h-10 bg-stone-100 border border-stone-200 rounded-lg flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-stone-600">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
              </svg>
            </div>
            <div>
              <p class="text-stone-900 font-semibold">Localização</p>
              <p class="text-stone-500 text-sm mt-0.5">Sorocaba/SP — atendemos toda a região</p>
            </div>
          </li>
        </ul>
      </div>

      <!-- Formulário -->
      <div>
        <h2 class="text-xl font-semibold text-stone-900 mb-8">Formulário de contato</h2>
        <form
          action="https://formspree.io/f/placeholder"
          method="POST"
          class="flex flex-col gap-5"
        >
          <div>
            <label for="nome" class="block text-sm font-medium text-stone-700 mb-1.5">Nome</label>
            <input
              id="nome"
              name="nome"
              type="text"
              required
              placeholder="Seu nome"
              class="w-full px-4 py-3 bg-stone-50 border border-stone-300 rounded-lg text-stone-900 text-sm placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-stone-900 focus:border-transparent transition"
            />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-stone-700 mb-1.5">E-mail</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              placeholder="seu@email.com"
              class="w-full px-4 py-3 bg-stone-50 border border-stone-300 rounded-lg text-stone-900 text-sm placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-stone-900 focus:border-transparent transition"
            />
          </div>
          <div>
            <label for="telefone" class="block text-sm font-medium text-stone-700 mb-1.5">Telefone (opcional)</label>
            <input
              id="telefone"
              name="telefone"
              type="tel"
              placeholder="(15) 99999-9999"
              class="w-full px-4 py-3 bg-stone-50 border border-stone-300 rounded-lg text-stone-900 text-sm placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-stone-900 focus:border-transparent transition"
            />
          </div>
          <div>
            <label for="servico" class="block text-sm font-medium text-stone-700 mb-1.5">Tipo de projeto</label>
            <select
              id="servico"
              name="servico"
              class="w-full px-4 py-3 bg-stone-50 border border-stone-300 rounded-lg text-stone-700 text-sm focus:outline-none focus:ring-2 focus:ring-stone-900 focus:border-transparent transition"
            >
              <option value="">Selecione um serviço</option>
              <option>Projeto Residencial</option>
              <option>Projeto Comercial</option>
              <option>Reforma e Retrofit</option>
              <option>Design de Interiores</option>
              <option>Administração de Obras</option>
              <option>Outro / Não sei ainda</option>
            </select>
          </div>
          <div>
            <label for="mensagem" class="block text-sm font-medium text-stone-700 mb-1.5">Mensagem</label>
            <textarea
              id="mensagem"
              name="mensagem"
              rows="4"
              required
              placeholder="Conta um pouco sobre o projeto — tamanho, localização, prazo estimado, orçamento aproximado..."
              class="w-full px-4 py-3 bg-stone-50 border border-stone-300 rounded-lg text-stone-900 text-sm placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-stone-900 focus:border-transparent transition resize-none"
            ></textarea>
          </div>
          <button
            type="submit"
            class="w-full bg-stone-900 text-stone-100 font-semibold py-3.5 rounded-lg hover:bg-stone-700 transition-colors text-sm"
          >
            Enviar mensagem
          </button>
          <p class="text-xs text-stone-400 text-center">
            Ou fale direto pelo <a href="https://wa.me/5515991252290?text=Ol%C3%A1%2C%20vim%20pelo%20site%20e%20gostaria%20de%20conversar%20sobre%20meu%20projeto" target="_blank" rel="noopener noreferrer" class="underline hover:text-stone-600">WhatsApp</a> — costuma ser mais rápido.
          </p>
        </form>
      </div>
    </div>
  </section>
</Layout>
